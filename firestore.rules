rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == "admin07029@fa-meeting-room.firebaseapp.com" ||
        request.auth.token.email == "admin09267@fa-meeting-room.firebaseapp.com"
      );
    }

    function isBookingOwner(bookingId) {
      return signedIn() &&
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.requesterUid == request.auth.uid;
    }

    match /employees/{employeeCode} {
      // Allows a single code lookup for employee-code login; directory listing is denied.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /bookingHistory/{bookingId} {
      // Full history is reserved for admins. Employees read only their separate,
      // employee-code history path below.
      allow get, list: if isAdmin();
      allow create: if signedIn() && request.resource.data.requesterUid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() &&
        resource.data.requesterUid == request.auth.uid &&
        request.resource.data.requesterUid == resource.data.requesterUid);
      allow delete: if isAdmin();
    }

    match /employeeHistory/{employeeCode}/entries/{bookingId} {
      // All devices logged in with the same employee code read the same path.
      // Anonymous UIDs are deliberately not used for reads because Firebase
      // assigns a different anonymous UID to each browser/device.
      // The employee code is already the parent document key. Reading the
      // collection directly also keeps legacy entries that predate the
      // requesterCode field visible on every device using the same code.
      allow get, list: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.requesterCode == employeeCode &&
        request.resource.data.requesterUid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() &&
        resource.data.requesterCode == employeeCode &&
        request.resource.data.requesterCode == employeeCode &&
        resource.data.requesterUid == request.auth.uid &&
        request.resource.data.requesterUid == resource.data.requesterUid);
      allow delete: if isAdmin();
    }

    match /publicBookings/{bookingId} {
      allow get, list: if true;
      allow create: if isAdmin() || (signedIn() &&
        request.resource.data.keys().hasOnly(['date', 'time', 'status', 'person']) &&
        request.resource.data.status == "pending" &&
        request.resource.data.date == get(/databases/$(database)/documents/bookings/$(bookingId)).data.date &&
        request.resource.data.time == get(/databases/$(database)/documents/bookings/$(bookingId)).data.time &&
        request.resource.data.person == get(/databases/$(database)/documents/bookings/$(bookingId)).data.person);
      allow update: if isAdmin() || (isBookingOwner(bookingId) &&
        request.resource.data.keys().hasOnly(['date', 'time', 'status', 'person']) &&
        request.resource.data.status == "pending" &&
        request.resource.data.date == get(/databases/$(database)/documents/bookings/$(bookingId)).data.date &&
        request.resource.data.time == get(/databases/$(database)/documents/bookings/$(bookingId)).data.time &&
        request.resource.data.person == get(/databases/$(database)/documents/bookings/$(bookingId)).data.person);
      allow delete: if isAdmin() || isBookingOwner(bookingId);
    }

    match /bookings/{bookingId} {
      // Employees only see approved bookings in the calendar; their own complete
      // status history is read from employeeHistory/{employeeCode}/entries.
      allow get, list: if isAdmin() || (
        signedIn() && resource.data.status == "approved"
      );

      allow create: if signedIn() &&
        request.resource.data.status == "pending" &&
        request.resource.data.requesterUid == request.auth.uid;

      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.status == "pending" &&
        resource.data.requesterUid == request.auth.uid &&
        request.resource.data.status in ["pending", "cancelled"] &&
        request.resource.data.requesterUid == resource.data.requesterUid
      );

      allow delete: if isAdmin() || (
        signedIn() &&
        resource.data.requesterUid == request.auth.uid
      );
    }
  }
}
